{
  "name": "mission-control",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml up --build",
    "docker:prod": "docker compose -f docker/docker-compose.yml up --build -d",
    "docker:down": "docker compose -f docker/docker-compose.yml -f docker/docker-compose.dev.yml down",
    "db:init": "bash scripts/init-db.sh"
  },
  "devDependencies": {
    "@vitest/ui": "^4.0.18",
    "turbo": "^1.13.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@10.2.4",
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "@xmldom/xmldom": "^0.9.0",
    "brace-expansion": "^5.0.5",
    "fast-xml-parser": "^5.7.0",
    "hono": "^4.13.0",
    "lodash": "^4.17.24",
    "minimatch": "^9.0.5",
    "node-forge": "^1.3.4",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.10",
    "protobufjs": "^7.5.5",
    "send": "^0.19.0",
    "tar": "^7.6.0",
    "uuid": "^14.0.0"
  }
}
